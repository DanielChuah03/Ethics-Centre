# GROW Ethics Centre — nginx reverse proxy.
#
# Single host, split by path. Terminates TLS with a Cloudflare ORIGIN
# CERTIFICATE and proxies to the two Node services (bound to 127.0.0.1, never
# exposed directly):
#
#   https://gec.dansops.com/          -> dashboard  (127.0.0.1:4318)   you log in here
#   https://gec.dansops.com/ingest    -> collector  (127.0.0.1:4319)   the agent ships here
#
# Topology: browser/agent --HTTPS--> Cloudflare (Full strict) --HTTPS--> nginx here.
#
# SETUP:
#   1. Cloudflare: SSL/TLS -> Origin Server -> Create Certificate. Save the cert
#      + key on this box at the paths below. (NOT Let's Encrypt; 15-year edge
#      cert, no renewal cron.) Set SSL/TLS mode to Full (strict).
#   2. Pre-filled for gec.dansops.com — change it here if your host differs.
#   3. Copy to /etc/nginx/sites-available/grow, symlink into sites-enabled,
#      `sudo nginx -t` then `sudo systemctl reload nginx`.
#
# Cloudflare Origin Certificate files (paste them in during DEPLOY.md):
#   /etc/ssl/cloudflare/origin.pem   (certificate)
#   /etc/ssl/cloudflare/origin.key   (private key, chmod 600)

server {
    listen 443 ssl;
    http2 on;
    server_name gec.dansops.com;

    ssl_certificate     /etc/ssl/cloudflare/origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/origin.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Allow a generous body size for batched events posted to /ingest.
    client_max_body_size 10m;

    # Collector — the agent POSTs batches here. Peeled off before the dashboard.
    location = /ingest {
        proxy_pass         http://127.0.0.1:4319/ingest;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    # Everything else — the operator dashboard (login, /data, etc.).
    location / {
        proxy_pass         http://127.0.0.1:4318;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}

# No :80 server block — port 80 is closed in the security group (least
# privilege). Cloudflare serves HTTPS at the edge and all URLs are https://.
# If you later open 80 for an HTTP->HTTPS redirect, add a `listen 80` server
# that does `return 301 https://$host$request_uri;`.
