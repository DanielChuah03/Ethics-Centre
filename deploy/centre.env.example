# GROW Ethics Centre — service environment.
# Copy to /etc/grow/centre.env, fill in, chmod 600, owned by the 'grow' user.
# Read by both systemd units (collector + dashboard). NEVER commit the real file.

# Signs dashboard session cookies. MUST be a long random string and MUST be
# stable (changing it logs everyone out). Generate once with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GROW_SESSION_SECRET=<paste-a-long-random-hex-string-here>

# Private key location (decryption trust anchor). Default is keys/centre-private.pem
# relative to WorkingDirectory; set an absolute path if you keep it elsewhere.
# GROW_CENTRE_PRIVATE_KEY_FILE=/opt/Ethics-Centre/keys/centre-private.pem

# Ports are set in the unit files (4319 collector / 4318 dashboard) and bound to
# 127.0.0.1 via GROW_BIND_HOST there — no need to repeat here.
